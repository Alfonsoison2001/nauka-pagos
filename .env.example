# ============================================================================
# NAUKA Pagos — Environment variables
# ============================================================================
# Copy this file to .env.local and fill real values for local development.
# Vercel production: set the same vars in Vercel dashboard (Settings → Env Vars).
# Never commit .env.local — it's in .gitignore.
# ============================================================================

# --- Supabase ---
# From: https://supabase.com/dashboard/project/poesjbliusrdoftibkru/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- Resend (for outgoing carátula emails) ---
# From: https://resend.com/api-keys
RESEND_API_KEY=re_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
